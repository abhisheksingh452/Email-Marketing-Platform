NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://emp:emp@localhost:5432/emp?schema=public
REDIS_URL=redis://localhost:6379

# 32+ chars. Used to HMAC IP addresses stored in audit logs / sessions.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=12

WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Used only by `pnpm api prisma:seed`
SEED_WORKSPACE_NAME=Default Workspace
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=ChangeMe-12345!
